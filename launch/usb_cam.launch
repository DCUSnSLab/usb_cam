<launch>
  <node name="cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/video2" />
    <param name="image_width" value="1920" />
    <param name="image_height" value="1080" />
    <param name="pixel_format" value="mjpeg" />
    <param name="framerate" value="20" />
    <param name="camera_frame_id" value="cam" />
    <param name="io_method" value="mmap"/>
    <param name="camera_info_url" value="file://$(find usb_cam)/camera_info/cam.yaml" />
  </node>
  <node pkg="usb_cam" type="undistort_node.py" name="image_undistorter" output="screen">
    <param name="image_topic" value="/cam/image_raw"/>
    <param name="undistorted_topic" value="/cam/image_undistorted"/>
    <param name="camera_info_path" value="$(find usb_cam)/camera_info/cam.yaml"/>
  </node>
</launch>
