<launch>
  <node name="cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/video2" />
    <param name="image_width" value="1920" />
    <param name="image_height" value="1080" />
    <param name="pixel_format" value="mjpeg" />
    <param name="color_format" value="yuv422p" />
    <param name="camera_frame_id" value="_cam" />
    <param name="io_method" value="mmap"/>
    <!-- <param name="camera_info_url" value="$(find usb_cam)/camera_info/cam.yaml" /> -->
  </node>

  <node name="camera_info_manager" pkg="camera_info_manager" type="camera_info_manager" output="screen">
    <param name="camera_name" value="cam" />
    <param name="camera_info_url" value="file://$(find usb_cam)/config/usb_cam.yml" />
  </node>
</launch>
